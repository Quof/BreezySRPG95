<Project Sdk="Microsoft.NET.Sdk">

  <!-- NLayer, the MP3 decoder: its source, vendored (see README.md) -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>3.0.0</Version>
    <!-- nothing beside the published single-file exe -->
    <DebugType Condition="'$(PublishSingleFile)' == 'true'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Srpg95.Data.Tests" />
  </ItemGroup>

</Project>
