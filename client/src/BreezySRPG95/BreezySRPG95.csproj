<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Srpg95.Data\Srpg95.Data.csproj" />
    <!-- the MP3 decoder (Runtime/Audio.cs: SetUpMp3), NLayer's source with two fixes -->
    <ProjectReference Include="..\NLayer\NLayer.csproj" />
  </ItemGroup>

  <!-- the tests reach the FreeType renderer's font handling (Ui/FreeTypeText.cs: FreeTypeFonts) -->
  <ItemGroup>
    <InternalsVisibleTo Include="Srpg95.Data.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MeltySynth" Version="2.4.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
    <!-- FreeType 2.13 for the text off Windows (Ui/FreeTypeText.cs); its native library for Windows, Linux x64 and macOS -->
    <PackageReference Include="FreeTypeSharp" Version="3.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- the player's name for the client; the project and namespaces keep the name it was started under -->
    <AssemblyName>BreezySRPG95</AssemblyName>
    <!-- the release version: the exe's file and product version (Properties > Details) -->
    <Version>0.1.0</Version>
    <Product>BreezySRPG95</Product>
    <AssemblyTitle>BreezySRPG95</AssemblyTitle>
    <Product>BreezySRPG95</Product>
    <Company>BreezySRPG95</Company>
    <RootNamespace>BreezySRPG95</RootNamespace>
    <!-- the exe's icon (Explorer, shortcuts); MonoGame takes the window's and taskbar's from the embedded Icon.ico / Icon.bmp -->
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- FreeType's API is pointers (Ui/FreeTypeText.cs) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Built-in SoundFont: GeneralUser GS v2.0.3 by S. Christian Collins (licence: soundfont/GeneralUser-GS-LICENSE.txt,
    which allows bundling it in software). It is embedded in the executable so every player gets the same music.
    The 32 MB .sf2 is not kept in git; the first build downloads it from the author's repository and checks its hash.
  -->
  <PropertyGroup>
    <SoundFontFile>$(MSBuildThisFileDirectory)soundfont\GeneralUser-GS.sf2</SoundFontFile>
    <SoundFontUrl>https://raw.githubusercontent.com/mrbumpy409/GeneralUser-GS/main/GeneralUser-GS.sf2</SoundFontUrl>
    <SoundFontSha256>9575028C7A1F589F5770FCCC8CFF2734566AF40CD26ED836944E9A5152688CFE</SoundFontSha256>
  </PropertyGroup>

  <Target Name="FetchSoundFont" BeforeTargets="PrepareForBuild" Condition="!Exists('$(SoundFontFile)')">
    <DownloadFile SourceUrl="$(SoundFontUrl)" DestinationFolder="$(MSBuildThisFileDirectory)soundfont" DestinationFileName="GeneralUser-GS.sf2" />
    <GetFileHash Files="$(SoundFontFile)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_SoundFontHash" />
    </GetFileHash>
    <Delete Files="$(SoundFontFile)" Condition="'$(_SoundFontHash)' != '$(SoundFontSha256)'" />
    <Error Condition="'$(_SoundFontHash)' != '$(SoundFontSha256)'" Text="GeneralUser-GS.sf2 download didn't match the expected SHA-256." />
  </Target>

  <!--
    OpenAL Soft 1.25.2 (Chris Robinson; LGPL, openal/COPYING) in place of the 1.18.1 MonoGame carries, for 64-bit
    Windows: it says when Windows' default output changes (ALC_SOFT_system_events) and can move a playing device to it
    (ALC_SOFT_reopen_device), so the sound follows a switch from speakers to headphones (Runtime/AudioDevice.cs). It needs
    only Windows' own DLLs. Not kept in git: the first build downloads the release's binaries, checks their hash and keeps
    the 64-bit soft_oal.dll and the licence.
  -->
  <PropertyGroup>
    <OpenAlDir>$(MSBuildThisFileDirectory)openal\</OpenAlDir>
    <OpenAlDll>$(OpenAlDir)soft_oal.dll</OpenAlDll>
    <OpenAlRelease>openal-soft-1.25.2-bin</OpenAlRelease>
    <OpenAlUrl>https://github.com/kcat/openal-soft/releases/download/1.25.2/$(OpenAlRelease).zip</OpenAlUrl>
    <OpenAlSha256>67A0C4B800BD860C93C04F38CAF8CBE4875F9C84700AC430EFC451F70E265434</OpenAlSha256>
  </PropertyGroup>

  <Target Name="FetchOpenAl" BeforeTargets="PrepareForBuild" Condition="!Exists('$(OpenAlDll)')">
    <DownloadFile SourceUrl="$(OpenAlUrl)" DestinationFolder="$(OpenAlDir)" DestinationFileName="$(OpenAlRelease).zip" />
    <GetFileHash Files="$(OpenAlDir)$(OpenAlRelease).zip" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_OpenAlHash" />
    </GetFileHash>
    <Delete Files="$(OpenAlDir)$(OpenAlRelease).zip" Condition="'$(_OpenAlHash)' != '$(OpenAlSha256)'" />
    <Error Condition="'$(_OpenAlHash)' != '$(OpenAlSha256)'" Text="$(OpenAlRelease).zip download didn't match the expected SHA-256." />
    <Unzip SourceFiles="$(OpenAlDir)$(OpenAlRelease).zip" DestinationFolder="$(OpenAlDir)unpacked"
           Include="$(OpenAlRelease)/bin/Win64/soft_oal.dll;$(OpenAlRelease)/COPYING" />
    <Copy SourceFiles="$(OpenAlDir)unpacked\$(OpenAlRelease)\bin\Win64\soft_oal.dll;$(OpenAlDir)unpacked\$(OpenAlRelease)\COPYING" DestinationFolder="$(OpenAlDir)" />
    <RemoveDir Directories="$(OpenAlDir)unpacked" />
    <Delete Files="$(OpenAlDir)$(OpenAlRelease).zip" />
  </Target>

  <!-- MonoGame's 64-bit Windows soft_oal.dll swapped for that one, wherever it goes (runtimes\win-x64\native\, or beside
       the program in a win-x64 build and its single file) -->
  <Target Name="UseNewerOpenAl" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_MonoGameOpenAl Include="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Filename)%(Extension)' == 'soft_oal.dll' And '%(RuntimeIdentifier)' == 'win-x64'" />
      <RuntimeTargetsCopyLocalItems Remove="@(_MonoGameOpenAl)" />
      <RuntimeTargetsCopyLocalItems Include="@(_MonoGameOpenAl->'$(OpenAlDll)')" />
      <_MonoGameOpenAlHere Include="@(NativeCopyLocalItems)" Condition="'%(Filename)%(Extension)' == 'soft_oal.dll' And '$(RuntimeIdentifier)' == 'win-x64'" />
      <NativeCopyLocalItems Remove="@(_MonoGameOpenAlHere)" />
      <NativeCopyLocalItems Include="@(_MonoGameOpenAlHere->'$(OpenAlDll)')" />
    </ItemGroup>
  </Target>

  <!-- The icon: 昴の騎士's FACE_003 on a gold-rimmed tile, made by
       client/tools/make_icon.py -->
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico" LogicalName="Icon.ico" />
    <EmbeddedResource Include="Icon.bmp" LogicalName="Icon.bmp" />
    <!-- gamepad buttons, 9 × 8 each, from DT3's sKeyPressPad (Ui/PadGlyphs.cs) -->
    <EmbeddedResource Include="pad\PadGlyphs.png" LogicalName="pad/PadGlyphs.png" />
  </ItemGroup>

  <!--
    The restyled skins' Noto Sans JP and Noto Serif JP (SIL OFL 1.1, fonts/OFL.txt), embedded so every PC has them. They
    aren't kept in git: the build copies them from Windows' own fonts folder (Windows 11 ships them) and leaves them out
    when they aren't there (the Font option then falls back to Yu Gothic UI). The pixel fonts — DotGothic16Pixel.ttf (made by tools/make_pixel_font.py), PixelMplus12
    (M+ FONT LICENSE, fonts/MPLUS-LICENSE.txt) and the KH Dot font's KH-Dot-Kodenmachou-12/16 — aren't Windows' and
    aren't in git either: put their .ttf files in fonts\ (client/README.md says where to get them) and they're embedded too.
    IPAGothic (fonts\ipag.ttf, IPA Font License v1.0, fonts\IPA_Font_License_Agreement_v1.0.txt) is the text renderer's
    stand-in for MS Gothic off Windows (Ui/FreeTypeText.cs): embedded as freetype/ipag.ttf, where GDI isn't given it, and
    left out of a Windows build (-r win-*), which draws with GDI and MS Gothic.
  -->
  <PropertyGroup>
    <FontsDir>$(MSBuildThisFileDirectory)fonts\</FontsDir>
  </PropertyGroup>
  <Target Name="EmbedFonts" BeforeTargets="PrepareForBuild">
    <Copy SourceFiles="$(WINDIR)\Fonts\%(FontFile.Identity)" DestinationFolder="$(FontsDir)"
          Condition="!Exists('$(FontsDir)%(FontFile.Identity)') And Exists('$(WINDIR)\Fonts\%(FontFile.Identity)')" />
    <ItemGroup>
      <_EmbeddedFont Include="$(FontsDir)*.ttf" Exclude="$(FontsDir)ipag.ttf" />
      <EmbeddedResource Include="@(_EmbeddedFont)" LogicalName="fonts/%(_EmbeddedFont.Filename)%(_EmbeddedFont.Extension)" />
      <EmbeddedResource Include="$(FontsDir)ipag.ttf" LogicalName="freetype/ipag.ttf"
                        Condition="Exists('$(FontsDir)ipag.ttf') And !$(RuntimeIdentifier.StartsWith('win'))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <FontFile Include="NotoSansJP-VF.ttf;NotoSerifJP-VF.ttf" />
    <EmbeddedResource Include="fonts\OFL.txt" LogicalName="fonts/OFL.txt" />
    <EmbeddedResource Include="fonts\MPLUS-LICENSE.txt" LogicalName="fonts/MPLUS-LICENSE.txt" />
  </ItemGroup>

  <!-- The grade shader, compiled from Shaders\Grade.fx (see its header for the command). -->
  <ItemGroup>
    <EmbeddedResource Include="Shaders\Grade.ogl.mgfx" LogicalName="Grade.ogl.mgfx" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="soundfont\GeneralUser-GS.sf2" LogicalName="GeneralUser-GS.sf2" />
  </ItemGroup>

  <!-- Publishing on Windows (-r win-x64): one BreezySRPG95.exe and nothing else — the runtime, SDL2, OpenAL and FreeType go
       inside it (the native ones are unpacked to a cache folder on first start, see client/README.md).
       On Linux and macOS (-r linux-x64, osx-x64, osx-arm64): the program in one file with its native libraries (SDL2, OpenAL,
       FreeType) as files beside it, where MonoGame and FreeTypeSharp look first: unpacked elsewhere, they'd be found after
       the system's own copies (/usr/lib), if any. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract Condition="$(RuntimeIdentifier.StartsWith('win'))">true</IncludeNativeLibrariesForSelfExtract>
    <!-- compressed inside the exe (the SoundFont and the fonts are most of it): about 35 MB smaller, no slower to start -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <!-- Linux and macOS builds need no ICU library (a Linux without one would refuse to start): nothing here sorts, compares or
       formats by culture — sorting is by numbers, names compare ordinally — so the invariant culture changes nothing -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' And !$(RuntimeIdentifier.StartsWith('win'))">
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
